# Local environment variables for the Research Web Crawler & API.
# Copy this file to ".env" and adjust values as needed.
# ".env" is gitignored and must never be committed.

# Port the API server listens on.
PORT=4000

# MongoDB connection string (Phase 6).
# Local MongoDB:     mongodb://127.0.0.1:27017/research_crawler
# MongoDB Atlas:     mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Leave unset to run the server without persistence.
MONGODB_URI=mongodb://127.0.0.1:27017/research_crawler

# Optional (Phase 7): comma-separated DNS servers used for Atlas SRV lookups.
# Some networks' resolvers refuse SRV queries; point Node at servers that
# answer them. Leave unset to use the OS default resolver.
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Security (Phase 8) ---

# Rate limits (requests per minute per IP).
# Crawls get a tighter budget because they make outbound requests.
RATE_LIMIT_MAX=120
CRAWL_RATE_LIMIT_MAX=10

# Comma-separated allowed CORS origins (or * for any origin / development).
# Lock this down before production.
CORS_ORIGINS=*

# Enable API-key auth for write endpoints (POST /api/crawls, DELETE research).
# Leave unset to keep the API open like before.
# API_KEY=change-me

# Crawler safety limits (Phase 3) — tuned here, overridable per request later.
# Conservative by default: the crawler must never hammer a site.
CRAWL_MAX_PAGES=20
CRAWL_MAX_DEPTH=2
CRAWL_DELAY_MS=1000
CRAWL_TIMEOUT_MS=10000